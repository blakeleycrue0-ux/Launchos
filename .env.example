# Copia este archivo como `.env.local` y rellena los valores.
# Nunca subas `.env.local` a GitHub (ya está en .gitignore).
#
# Ambos valores son PÚBLICOS por diseño (acaban dentro del bundle del navegador).
# La seguridad de los datos depende de Row Level Security en Supabase.
# NUNCA pongas aquí la clave `service_role` ni ninguna `sb_secret_...`.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...) o la clave anon (legacy)
VITE_SUPABASE_PUBLISHABLE_KEY=
